<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_collapsed_root"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="#0A120D">

    <ImageView
        android:id="@+id/notif_collapsed_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_notification_server"
        android:contentDescription="Matrix Server Icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/notif_collapsed_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MATRIX SERVER • ONLINE"
            android:textColor="#00FF66"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/notif_collapsed_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ssh matrix@127.0.0.1 -p 2222"
            android:textColor="#9EBAA7"
            android:textSize="11sp"
            android:singleLine="true"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btn_notif_collapsed_copy"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_notification_button"
            android:src="@drawable/ic_notification_copy"
            android:contentDescription="Copy SSH Command"
            android:padding="7dp" />

        <ImageButton
            android:id="@+id/btn_notif_collapsed_stop"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_notification_stop_button"
            android:src="@drawable/ic_notification_stop"
            android:contentDescription="Stop Server"
            android:padding="8dp" />
    </LinearLayout>

</LinearLayout>
