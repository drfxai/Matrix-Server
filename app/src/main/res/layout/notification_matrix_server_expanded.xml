<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#0A120D">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/notif_expanded_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_notification_server"
            android:contentDescription="Matrix Server Icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/notif_expanded_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MATRIX SERVER • LINUX NODE"
                android:textColor="#00FF66"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/notif_expanded_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Background SSH Service Active"
                android:textColor="#809988"
                android:textSize="10sp"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/notif_expanded_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ONLINE"
            android:textColor="#00FF66"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_notification_button"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- Shell Connection Command Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_notification_box"
        android:padding="8dp"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$ "
            android:textColor="#00FF66"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_expanded_command"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ssh matrix@127.0.0.1 -p 2222"
            android:textColor="#D5E8DC"
            android:textSize="11sp"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Telemetry Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/notif_expanded_clients"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Clients: 0 active"
            android:textColor="#9EBAA7"
            android:textSize="10sp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/notif_expanded_ram"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RAM: --"
            android:textColor="#9EBAA7"
            android:textSize="10sp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/notif_expanded_uptime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Uptime: 00:00:00"
            android:textColor="#9EBAA7"
            android:textSize="10sp"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Actions Control Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <!-- Stop Server Control -->
        <Button
            android:id="@+id/btn_notif_expanded_stop"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="STOP SERVER"
            android:textColor="#FF4D4D"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_notification_stop_button"
            android:padding="0dp"
            android:drawableStart="@drawable/ic_notification_stop"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <View
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <!-- Copy SSH Command Control -->
        <Button
            android:id="@+id/btn_notif_expanded_copy"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="COPY SSH"
            android:textColor="#00FF66"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_notification_button"
            android:padding="0dp"
            android:drawableStart="@drawable/ic_notification_copy"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <View
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <!-- Open Console Control -->
        <Button
            android:id="@+id/btn_notif_expanded_open"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="CONSOLE"
            android:textColor="#D5E8DC"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_notification_button"
            android:padding="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </LinearLayout>

</LinearLayout>
